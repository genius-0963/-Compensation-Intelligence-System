generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MODERATOR
  USER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  INTERN
  CONTRACT
  PART_TIME
}

enum CandidateStatus {
  ACTIVE
  INTERVIEWING
  OFFER_EXTENDED
  HIRED
  REJECTED
  WITHDRAWN
}

enum OfferStatus {
  DRAFT
  PENDING
  APPROVED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InsightType {
  NEGOTIATION
  MARKET_POSITION
  EQUITY_ANALYSIS
  RETENTION_RISK
  COUNTER_OFFER
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  role                  UserRole  @default(USER)
  
  careerStage           String?
  currentCompany        String?
  targetCompensation    Float?
  yearsExperience       Float?    @default(0)
  location              String?
  notificationPrefs     Json?     
  
  accounts              Account[]
  sessions              Session[]
  
  submissions           CompensationSubmission[]
  watchlists            Watchlist[]
  savedComparisons      SavedComparison[]
  auditLogs             AuditLog[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  logoUrl        String?
  industry       String?
  headcount      Int?
  hqLocation     String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  levels         Level[]
  compensations  CompensationEntry[]
  submissions    CompensationSubmission[]
  watchlistedBy  Watchlist[]

  @@map("companies")
}

model RoleFamily {
  id            String   @id @default(cuid())
  name          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  compensations CompensationEntry[]
  submissions   CompensationSubmission[]

  @@map("role_families")
}

model Level {
  id                  String   @id @default(cuid())
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id])
  code                String   @unique
  name                String
  rank                Int?     @unique
  normalizedLevelRank Int?     
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  compensations       CompensationEntry[]
  submissions         CompensationSubmission[]
  employees           Employee[]
  bands               CompensationBand[]
  benchmarks          SalaryBenchmark[]
  offers              Offer[]

  @@map("levels")
}

model Location {
  id                 String             @id @default(cuid())
  city               String
  state              String?
  country            String
  region             String?
  costOfLivingIndex  Float              @default(1.0)
  currency           String             @default("USD")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  compensations      CompensationEntry[]
  submissions        CompensationSubmission[]
  watchlistedBy      Watchlist[]
  employees          Employee[]
  bands              CompensationBand[]
  benchmarks         SalaryBenchmark[]
  offers             Offer[]
  marketDataPoints   MarketDataPoint[]

  @@unique([city, state, country])
  @@map("locations")
}

model CompensationEntry {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id])
  roleFamilyId      String
  roleFamily        RoleFamily @relation(fields: [roleFamilyId], references: [id])
  levelId           String
  level             Level      @relation(fields: [levelId], references: [id])
  locationId        String
  location          Location   @relation(fields: [locationId], references: [id])
  
  baseSalary        Float
  bonus             Float      @default(0)
  stock             Float      @default(0)
  other             Float      @default(0)
  totalCompensation Float
  
  currency          String     @default("USD")
  yearsExperience   Float
  yearsAtCompany    Float?
  
  submittedAt       DateTime   @default(now())
  isVerified        Boolean    @default(false)
  source            String?    

  @@index([totalCompensation])
  @@index([companyId, roleFamilyId])
  @@index([levelId])
  @@index([locationId])
  @@map("compensation_entries")
}

model CompensationSubmission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status            SubmissionStatus @default(DRAFT)
  
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  employmentType    EmploymentType   @default(FULL_TIME)
  roleFamilyId      String
  roleFamily        RoleFamily       @relation(fields: [roleFamilyId], references: [id])
  department        String?
  locationId        String
  location          Location         @relation(fields: [locationId], references: [id])
  isRemote          Boolean          @default(false)
  
  levelId           String
  level             Level            @relation(fields: [levelId], references: [id])
  
  baseSalary        Float
  annualBonus       Float            @default(0)
  signingBonus      Float            @default(0)
  performanceBonus  Float            @default(0)
  stockGrantValue   Float            @default(0) 
  refreshers        Float            @default(0)
  relocationBonus   Float            @default(0)
  otherCompensation Float            @default(0)
  totalCompensation Float            
  currency          String           @default("USD")
  
  yearsExperience   Float
  yearsAtCompany    Float?
  
  documents         SubmissionDocument[]
  insights          CompensationInsight[]
  
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("compensation_submissions")
}

model SubmissionDocument {
  id             String                 @id @default(cuid())
  submissionId   String
  submission     CompensationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  fileName       String
  fileUrl        String                 
  fileType       String                 
  fileSize       Int
  
  createdAt      DateTime               @default(now())

  @@index([submissionId])
  @@map("submission_documents")
}

model CompensationInsight {
  id             String                 @id @default(cuid())
  submissionId   String
  submission     CompensationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  type           String                 
  message        String
  value          Float?
  
  createdAt      DateTime               @default(now())

  @@index([submissionId])
  @@map("compensation_insights")
}

model Watchlist {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id])
  roleFamilyName String?
  levelRank      Int?
  
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("watchlists")
}

model SavedComparison {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title          String
  config         Json     
  
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("saved_comparisons")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  reason         String?
  
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  headCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  roles       Role[]
  employees   Employee[]

  @@map("departments")
}

model Role {
  id               String             @id @default(cuid())
  title            String
  family           String
  description      String?
  departmentId     String
  department       Department         @relation(fields: [departmentId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employees        Employee[]
  bands            CompensationBand[]
  benchmarks       SalaryBenchmark[]
  offers           Offer[]
  marketDataPoints MarketDataPoint[]

  @@index([departmentId])
  @@map("roles")
}

model Employee {
  id                String          @id @default(cuid())
  employeeId        String          @unique
  firstName         String
  lastName          String
  email             String          @unique
  phone             String?
  avatarUrl         String?
  roleId            String
  levelId           String
  locationId        String
  departmentId      String
  currentSalary     Float
  equity            Float           @default(0)
  bonus             Float           @default(0)
  totalCompensation Float
  hireDate          DateTime
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  role              Role            @relation(fields: [roleId], references: [id])
  level             Level           @relation(fields: [levelId], references: [id])
  location          Location        @relation(fields: [locationId], references: [id])
  department        Department      @relation(fields: [departmentId], references: [id])
  salaryHistory     SalaryHistory[]

  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@index([departmentId])
  @@map("employees")
}

model Candidate {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  currentCompany String?
  currentTitle   String?
  currentSalary  Float?
  expectedSalary Float?
  noticePeriod   String?
  source         String?
  status         CandidateStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  offers         Offer[]

  @@map("candidates")
}

model CompensationBand {
  id            String    @id @default(cuid())
  roleId        String
  levelId       String
  locationId    String
  minSalary     Float
  midSalary     Float
  maxSalary     Float
  currency      String    @default("USD")
  effectiveDate DateTime
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role          Role      @relation(fields: [roleId], references: [id])
  level         Level     @relation(fields: [levelId], references: [id])
  location      Location  @relation(fields: [locationId], references: [id])

  @@unique([roleId, levelId, locationId])
  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("compensation_bands")
}

model SalaryBenchmark {
  id            String   @id @default(cuid())
  roleId        String
  levelId       String
  locationId    String
  p10           Float
  p25           Float
  p50           Float
  p75           Float
  p90           Float
  source        String
  surveyDate    DateTime
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role          Role     @relation(fields: [roleId], references: [id])
  level         Level    @relation(fields: [levelId], references: [id])
  location      Location @relation(fields: [locationId], references: [id])

  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("salary_benchmarks")
}

model MarketDataPoint {
  id           String   @id @default(cuid())
  roleId       String
  locationId   String
  period       DateTime
  medianSalary Float
  meanSalary   Float?
  sampleSize   Int?
  source       String
  yoyGrowth    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         Role     @relation(fields: [roleId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])

  @@index([roleId])
  @@index([locationId])
  @@map("market_data_points")
}

model Offer {
  id                String          @id @default(cuid())
  candidateId       String
  roleId            String
  levelId           String
  locationId        String
  baseSalary        Float
  equity            Float           @default(0)
  signingBonus      Float           @default(0)
  annualBonus       Float           @default(0)
  totalCompensation Float
  score             Float?
  scoreGrade        String?
  status            OfferStatus     @default(DRAFT)
  notes             String?
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  candidate         Candidate       @relation(fields: [candidateId], references: [id])
  role              Role            @relation(fields: [roleId], references: [id])
  level             Level           @relation(fields: [levelId], references: [id])
  location          Location        @relation(fields: [locationId], references: [id])
  insights          NegotiationInsight[]

  @@index([candidateId])
  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("offers")
}

model SalaryHistory {
  id               String   @id @default(cuid())
  employeeId       String
  previousSalary   Float
  newSalary        Float
  changePercentage Float
  reason           String
  effectiveDate    DateTime
  createdAt        DateTime @default(now())

  employee         Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("salary_histories")
}

model NegotiationInsight {
  id         String      @id @default(cuid())
  offerId    String
  type       InsightType
  title      String
  insight    String
  confidence Float
  priority   Int         @default(0)
  metadata   String?     // Using String to store serialized JSON for SQLite compatibility, or use Json if on Postgres
  createdAt  DateTime    @default(now())

  offer      Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("negotiation_insights")
}
