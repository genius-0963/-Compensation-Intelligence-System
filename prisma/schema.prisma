generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MODERATOR
  USER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  INTERN
  CONTRACT
  PART_TIME
}

enum CandidateStatus {
  ACTIVE
  INTERVIEWING
  OFFER_EXTENDED
  HIRED
  REJECTED
  WITHDRAWN
}

enum OfferStatus {
  DRAFT
  EXTENDED
  NEGOTIATING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightCategory {
  BASE_SALARY
  EQUITY
  BONUS
  LOCATION
  LEVEL
  MARKET_POSITION
  RETENTION_RISK
  NEGOTIATION_OPPORTUNITY
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  password_hash         String?
  emailVerified         DateTime?
  image                 String?
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  role                  UserRole  @default(USER)
  
  careerStage           String?
  currentCompany        String?
  targetCompensation    Float?
  yearsExperience       Float?    @default(0)
  location              String?
  roleFamily            String?
  interestedCompanies   String[]
  compensationGoals     String?
  phone                 String?
  bio                   String?
  level                 String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  notificationPrefs     Json?     
  avatarUrl             String?
  timezone              String?
  currency              String?
  preferences           Json?
  
  accounts              Account[]
  sessions              Session[]
  userSessions          UserSession[]
  userActivities        UserActivity[]
  userPreferences       UserPreference[]
  connectedAccounts     ConnectedAccount[]
  
  submissions           CompensationSubmission[]
  savedComparisons      SavedComparison[]
  auditLogs             AuditLog[]

  savedCompanies        SavedCompany[]
  savedLevels           SavedLevel[]
  savedLocations        SavedLocation[]
  advisorConversations  AdvisorConversation[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  
  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  logoUrl        String?
  industry       String?
  headcount      Int?
  hqLocation     String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  levels         Level[]
  compensations  CompensationEntry[]
  submissions    CompensationSubmission[]
  savedBy        SavedCompany[]

  @@map("companies")
}

model RoleFamily {
  id            String   @id @default(cuid())
  name          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  compensations CompensationEntry[]
  submissions   CompensationSubmission[]

  @@map("role_families")
}

model Level {
  id                  String   @id @default(cuid())
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id])
  code                String   @unique
  name                String
  rank                Int?     @unique
  normalizedLevelRank Int?     
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  compensations       CompensationEntry[]
  submissions         CompensationSubmission[]
  employees           Employee[]
  bands               CompensationBand[]
  benchmarks          SalaryBenchmark[]
  offers              Offer[]
  savedBy             SavedLevel[]

  @@map("levels")
}

model Location {
  id                 String             @id @default(cuid())
  city               String
  state              String?
  country            String
  region             String?
  latitude           Float?
  longitude          Float?
  heroImage          String?
  thumbnailImage     String?
  costOfLivingIndex  Float              @default(1.0)
  pppIndex           Float              @default(1.0)
  growthRate         Float              @default(0.0)
  relocationScore    Float              @default(5.0)
  currency           String             @default("USD")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  compensations      CompensationEntry[]
  submissions        CompensationSubmission[]
  employees          Employee[]
  bands              CompensationBand[]
  benchmarks         SalaryBenchmark[]
  offers             Offer[]
  marketDataPoints   MarketDataPoint[]
  savedBy            SavedLocation[]

  @@unique([city, state, country])
  @@map("locations")
}

model CompensationEntry {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id])
  roleFamilyId      String
  roleFamily        RoleFamily @relation(fields: [roleFamilyId], references: [id])
  levelId           String
  level             Level      @relation(fields: [levelId], references: [id])
  locationId        String
  location          Location   @relation(fields: [locationId], references: [id])
  
  baseSalary        Float
  bonus             Float      @default(0)
  stock             Float      @default(0)
  other             Float      @default(0)
  totalCompensation Float
  
  currency          String     @default("USD")
  yearsExperience   Float
  yearsAtCompany    Float?
  
  submittedAt       DateTime   @default(now())
  isVerified        Boolean    @default(false)
  source            String?    

  @@index([totalCompensation])
  @@index([companyId, roleFamilyId])
  @@index([levelId])
  @@index([locationId])
  @@map("compensation_entries")
}

model CompensationSubmission {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status            SubmissionStatus @default(DRAFT)
  
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  employmentType    EmploymentType   @default(FULL_TIME)
  roleFamilyId      String
  roleFamily        RoleFamily       @relation(fields: [roleFamilyId], references: [id])
  department        String?
  locationId        String
  location          Location         @relation(fields: [locationId], references: [id])
  isRemote          Boolean          @default(false)
  
  levelId           String
  level             Level            @relation(fields: [levelId], references: [id])
  
  baseSalary        Float
  annualBonus       Float            @default(0)
  signingBonus      Float            @default(0)
  performanceBonus  Float            @default(0)
  stockGrantValue   Float            @default(0) 
  refreshers        Float            @default(0)
  relocationBonus   Float            @default(0)
  otherCompensation Float            @default(0)
  totalCompensation Float            
  currency          String           @default("USD")
  
  yearsExperience   Float
  yearsAtCompany    Float?
  
  documents         SubmissionDocument[]
  insights          CompensationInsight[]
  
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("compensation_submissions")
}

model SubmissionDocument {
  id             String                 @id @default(cuid())
  submissionId   String
  submission     CompensationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  fileName       String
  fileUrl        String                 
  fileType       String                 
  fileSize       Int
  
  createdAt      DateTime               @default(now())

  @@index([submissionId])
  @@map("submission_documents")
}

model CompensationInsight {
  id             String                 @id @default(cuid())
  submissionId   String
  submission     CompensationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  type           String                 
  message        String
  value          Float?
  
  createdAt      DateTime               @default(now())

  @@index([submissionId])
  @@map("compensation_insights")
}

model SavedComparison {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  config         Json     
  
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("saved_comparisons")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  reason         String?
  
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  headCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  roles       Role[]
  employees   Employee[]

  @@map("departments")
}

model Role {
  id               String             @id @default(cuid())
  title            String
  family           String
  description      String?
  departmentId     String
  department       Department         @relation(fields: [departmentId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employees        Employee[]
  bands            CompensationBand[]
  benchmarks       SalaryBenchmark[]
  offers           Offer[]
  marketDataPoints MarketDataPoint[]

  @@index([departmentId])
  @@map("roles")
}

model Employee {
  id                String          @id @default(cuid())
  employeeId        String          @unique
  firstName         String
  lastName          String
  email             String          @unique
  phone             String?
  avatarUrl         String?
  roleId            String
  levelId           String
  locationId        String
  departmentId      String
  currentSalary     Float
  equity            Float           @default(0)
  bonus             Float           @default(0)
  totalCompensation Float
  hireDate          DateTime
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  role              Role            @relation(fields: [roleId], references: [id])
  level             Level           @relation(fields: [levelId], references: [id])
  location          Location        @relation(fields: [locationId], references: [id])
  department        Department      @relation(fields: [departmentId], references: [id])
  salaryHistory     SalaryHistory[]

  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@index([departmentId])
  @@map("employees")
}

model Candidate {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  currentCompany String?
  currentTitle   String?
  currentSalary  Float?
  expectedSalary Float?
  noticePeriod   String?
  source         String?
  status         CandidateStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  offers         Offer[]

  @@map("candidates")
}

model CompensationBand {
  id            String    @id @default(cuid())
  roleId        String
  levelId       String
  locationId    String
  minSalary     Float
  midSalary     Float
  maxSalary     Float
  currency      String    @default("USD")
  effectiveDate DateTime
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role          Role      @relation(fields: [roleId], references: [id])
  level         Level     @relation(fields: [levelId], references: [id])
  location      Location  @relation(fields: [locationId], references: [id])

  @@unique([roleId, levelId, locationId])
  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("compensation_bands")
}

model SalaryBenchmark {
  id            String   @id @default(cuid())
  roleId        String
  levelId       String
  locationId    String
  p10           Float
  p25           Float
  p50           Float
  p75           Float
  p90           Float
  source        String
  surveyDate    DateTime
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role          Role     @relation(fields: [roleId], references: [id])
  level         Level    @relation(fields: [levelId], references: [id])
  location      Location @relation(fields: [locationId], references: [id])

  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("salary_benchmarks")
}

model MarketDataPoint {
  id           String   @id @default(cuid())
  roleId       String
  locationId   String
  period       DateTime
  medianSalary Float
  meanSalary   Float?
  sampleSize   Int?
  source       String
  yoyGrowth    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         Role     @relation(fields: [roleId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])

  @@index([roleId])
  @@index([locationId])
  @@map("market_data_points")
}

model Offer {
  id                String          @id @default(cuid())
  candidateId       String
  roleId            String
  levelId           String
  locationId        String
  baseSalary        Float
  equity            Float           @default(0)
  signingBonus      Float           @default(0)
  annualBonus       Float           @default(0)
  totalCompensation Float
  score             Float?
  scoreGrade        String?
  status            OfferStatus     @default(DRAFT)
  notes             String?
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  candidate         Candidate       @relation(fields: [candidateId], references: [id])
  role              Role            @relation(fields: [roleId], references: [id])
  level             Level           @relation(fields: [levelId], references: [id])
  location          Location        @relation(fields: [locationId], references: [id])
  insights          NegotiationInsight[]

  @@index([candidateId])
  @@index([roleId])
  @@index([levelId])
  @@index([locationId])
  @@map("offers")
}

model SalaryHistory {
  id               String   @id @default(cuid())
  employeeId       String
  previousSalary   Float
  newSalary        Float
  changePercentage Float
  reason           String
  effectiveDate    DateTime
  createdAt        DateTime @default(now())

  employee         Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("salary_histories")
}

model NegotiationInsight {
  id          String          @id @default(cuid())
  offerId     String
  title       String
  description String
  severity    Severity
  confidence  Float
  category    InsightCategory
  createdAt   DateTime        @default(now())

  offer       Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("negotiation_insights")
}

model SavedCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@map("saved_companies")
}

model SavedLevel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, levelId])
  @@map("saved_levels")
}

model SavedLocation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@map("saved_locations")
}

model AdvisorConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  mode        String   @default("GENERAL")
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages        AdvisorMessage[]
  recommendations AdvisorRecommendation[]

  @@index([userId])
  @@map("advisor_conversations")
}

model AdvisorMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  attachments    AdvisorAttachment[]

  @@index([conversationId])
  @@map("advisor_messages")
}

model AdvisorAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     AdvisorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type        String
  referenceId String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@map("advisor_attachments")
}

model AdvisorRecommendation {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  content        Json
  confidence     Float?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@map("advisor_recommendations")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String?
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  lastActive   DateTime @default(now())
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model UserActivity {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("user_activities")
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme            String   @default("system")
  defaultCurrency  String   @default("USD")
  defaultLocation  String?
  marketingEmails  Boolean  @default(true)
  productUpdates   Boolean  @default(true)
  securityAlerts   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_preferences")
}

model ConnectedAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  providerId   String
  username     String?
  email        String?
  connectedAt  DateTime @default(now())
  lastSyncedAt DateTime?

  @@unique([userId, provider])
  @@index([userId])
  @@map("connected_accounts")
}

